# Server Port & Environment
PORT=4000
NODE_ENV=production

# PostgreSQL Database Connection URL (Supabase, Neon, Railway, Render Postgres, or local)
# Example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/podstudio?schema=public"

# JWT Secret Key for Native Auth (Generate with: openssl rand -base64 32)
JWT_SECRET="your-secure-random-jwt-secret-min-32-characters"

# Allowed Frontend Origins (Comma-separated for multiple origins)
# Example: https://podstudio.vercel.app,http://localhost:5173
CLIENT_URL="http://localhost:5173,https://your-frontend-domain.vercel.app"

# Cloudinary Credentials for Master Video Track Storage (from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Clerk Authentication Keys (Optional - only needed if using Clerk SSO/Social Logins)
CLERK_PUBLISHABLE_KEY="pk_test_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key"

# Guest JWT Secret (separate from main JWT_SECRET for security isolation)
# Generate with: openssl rand -base64 32
GUEST_JWT_SECRET="your-guest-jwt-secret-min-32-characters"

# SMTP Configuration for OTP Emails (Nodemailer)
# Leave blank in development to log OTPs to console instead of sending emails.
# For production: use Gmail SMTP, SendGrid SMTP, Resend SMTP, AWS SES, etc.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="PodStudio <noreply@podstudio.app>"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5