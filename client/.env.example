# Backend API Endpoint (e.g. https://your-api.onrender.com/api or http://localhost:4000/api)
VITE_API_URL=http://localhost:4000/api

# Backend Socket.IO Endpoint (e.g. https://your-api.onrender.com or http://localhost:4000)
VITE_SOCKET_URL=http://localhost:4000

# Clerk Authentication Publishable Key (from dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key_here

# Optional WebRTC TURN Server (e.g. from Metered.ca, Twilio, or Xirsys)
# Required when participants are on different networks / restrictive NATs
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
